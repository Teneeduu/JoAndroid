[
  {
    "text": "千里之行，始于足下。",
    "source": "老子"
  },
  {
    "text": "天行健，君子以自强不息。",
    "source": "周易"
  },
  {
    "text": "不积跬步，无以至千里；不积小流，无以成江海。",
    "source": "荀子"
  },
  {
    "text": "锲而舍之，朽木不折；锲而不舍，金石可镂。",
    "source": "荀子"
  },
  {
    "text": "学而时习之，不亦说乎。",
    "source": "论语"
  },
  {
    "text": "知之者不如好之者，好之者不如乐之者。",
    "source": "论语"
  },
  {
    "text": "三人行，必有我师焉。",
    "source": "论语"
  },
  {
    "text": "逝者如斯夫，不舍昼夜。",
    "source": "论语"
  },
  {
    "text": "工欲善其事，必先利其器。",
    "source": "论语"
  },
  {
    "text": "士不可以不弘毅，任重而道远。",
    "source": "论语"
  },
  {
    "text": "博学之，审问之，慎思之，明辨之，笃行之。",
    "source": "礼记"
  },
  {
    "text": "苟日新，日日新，又日新。",
    "source": "礼记"
  },
  {
    "text": "凡事预则立，不预则废。",
    "source": "礼记"
  },
  {
    "text": "玉不琢，不成器；人不学，不知道。",
    "source": "礼记"
  },
  {
    "text": "天将降大任于斯人也，必先苦其心志，劳其筋骨。",
    "source": "孟子"
  },
  {
    "text": "穷则独善其身，达则兼济天下。",
    "source": "孟子"
  },
  {
    "text": "尽信书，则不如无书。",
    "source": "孟子"
  },
  {
    "text": "吾生也有涯，而知也无涯。",
    "source": "庄子"
  },
  {
    "text": "水之积也不厚，则其负大舟也无力。",
    "source": "庄子"
  },
  {
    "text": "合抱之木，生于毫末；九层之台，起于累土。",
    "source": "老子"
  },
  {
    "text": "知人者智，自知者明。",
    "source": "老子"
  },
  {
    "text": "胜人者有力，自胜者强。",
    "source": "老子"
  },
  {
    "text": "天下难事，必作于易；天下大事，必作于细。",
    "source": "老子"
  },
  {
    "text": "非淡泊无以明志，非宁静无以致远。",
    "source": "诸葛亮"
  },
  {
    "text": "勿以恶小而为之，勿以善小而不为。",
    "source": "刘备"
  },
  {
    "text": "老骥伏枥，志在千里。",
    "source": "曹操"
  },
  {
    "text": "长风破浪会有时，直挂云帆济沧海。",
    "source": "李白"
  },
  {
    "text": "天生我材必有用，千金散尽还复来。",
    "source": "李白"
  },
  {
    "text": "会当凌绝顶，一览众山小。",
    "source": "杜甫"
  },
  {
    "text": "读书破万卷，下笔如有神。",
    "source": "杜甫"
  },
  {
    "text": "业精于勤，荒于嬉；行成于思，毁于随。",
    "source": "韩愈"
  },
  {
    "text": "纸上得来终觉浅，绝知此事要躬行。",
    "source": "陆游"
  },
  {
    "text": "山重水复疑无路，柳暗花明又一村。",
    "source": "陆游"
  },
  {
    "text": "不畏浮云遮望眼，只缘身在最高层。",
    "source": "王安石"
  },
  {
    "text": "问渠那得清如许，为有源头活水来。",
    "source": "朱熹"
  },
  {
    "text": "少年易老学难成，一寸光阴不可轻。",
    "source": "朱熹"
  },
  {
    "text": "宝剑锋从磨砺出，梅花香自苦寒来。",
    "source": "警世贤文"
  },
  {
    "text": "路漫漫其修远兮，吾将上下而求索。",
    "source": "屈原"
  },
  {
    "text": "有志者事竟成。",
    "source": "后汉书"
  },
  {
    "text": "见善如不及，见不善如探汤。",
    "source": "论语"
  }
]
